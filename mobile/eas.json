{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    },
    "diagnose": {
      "extends": "production",
      "env": {
        "RCT_USE_PREBUILT_RNCORE": "0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "language": "ja-JP",
        "ascAppId": "6800513636"
      }
    }
  }
}
