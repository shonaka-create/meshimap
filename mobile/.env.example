# iOS版(Expo)用のテンプレート。これをコピーして mobile/.env を作る。
# ★ このファイルには値を書かないこと（Gitに追跡されます）

# ---- Supabase ----
# Dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---- Google Maps ----
# iOS の Maps SDK 用。「iOSアプリ」制限 + バンドルID com.shonaka.meshimap をかける。
GOOGLE_MAPS_IOS_KEY=
# Android の Maps SDK 用（iOSのみなら空でよい）
GOOGLE_MAPS_ANDROID_KEY=
# 逆ジオコーディング(Geocoding API + Places API)用。
# 端末から直接叩くためアプリ制限が効かない。API制限と日次上限を必ず設定する。
EXPO_PUBLIC_GOOGLE_GEOCODING_KEY=
