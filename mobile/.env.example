# iOS版(Expo)用のテンプレート。これをコピーして mobile/.env を作る。
# ★ このファイルには値を書かないこと（Gitに追跡されます）

# ---- Supabase ----
# Dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---- Google Maps ----
# iOS の Maps SDK 用。「iOSアプリ」制限 + バンドルID com.shonaka.meshimap をかける。
# ★ これはアプリに入ってよい鍵。バンドルIDで縛れるため。
GOOGLE_MAPS_IOS_KEY=
# Android の Maps SDK 用（iOSのみなら空でよい）
GOOGLE_MAPS_ANDROID_KEY=

# ---- 逆ジオコーディングを頼む先 ----
# 例: https://meshimap.vercel.app
#
# ★ Geocoding の鍵はアプリに持たせない。
#   Geocoding は「ウェブサービス API」で、HTTP リファラ制限も
#   バンドルID制限も効かない。配布物から抜かれると請求を止められない。
#   鍵は Vercel 側の GOOGLE_GEOCODING_KEY にだけ置き、
#   アプリはログイン済みトークンを添えて /api/geocode に問い合わせる。
#
# 空でも投稿は止まらない（内蔵の地域データだけで都道府県・エリアを決める）。
EXPO_PUBLIC_WEB_URL=
