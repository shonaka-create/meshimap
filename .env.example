# Web版(Next.js)用のテンプレート。これをコピーして .env.local を作る。
# ★ このファイルには値を書かないこと（Gitに追跡されます）

# Supabase: Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps (Maps JavaScript API)。HTTPリファラ制限をかける。
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── ここから下は「サーバーだけ」で使う鍵 ────────────────────
# ★ NEXT_PUBLIC_ を付けないこと。付けるとブラウザに出て、
#   抜かれたあとに請求を止める手段が無くなる（どちらもウェブサービスAPIで、
#   リファラ制限もバンドルID制限も効かない）。用途ごとに別の鍵を作る。

# 逆ジオコーディング（/api/geocode）。API制限は geocoding-backend のみ。
GOOGLE_GEOCODING_KEY=

# 投稿時の店名検索（/api/places/search・/api/places/detail）。
# API制限は Places API (New) のみ。未設定でも投稿は止まらない
# （店名の候補が出ないだけで、過去に登録された店と駅名・地名では探せる）。
GOOGLE_PLACES_KEY=
